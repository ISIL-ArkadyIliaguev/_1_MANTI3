<?xml version="1.0" encoding="UTF-8"?>
<!--
  MANTI3 Outlook add-in (development). One ribbon button on a message: it opens the access-requests page in a popup.
  Hosted by the Blazor frontend itself, so the frontend must run on https://localhost:7296
  (scripts\dev.ps1 start). To use another address, replace every https://localhost:7296 below.
  Install: docs/how-to/outlook-addin.md
-->
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
    xsi:type="MailApp">

  <Id>f53a0bf0-37d2-494c-9a06-bed245e50d0b</Id>
  <Version>1.3.0.0</Version>
  <ProviderName>MANTI3</ProviderName>
  <DefaultLocale>he-IL</DefaultLocale>
  <DisplayName DefaultValue="MANTI3 הרשאות" />
  <Description DefaultValue="פותח את בקשת ההרשאות של MANTI3 בחלון קופץ." />
  <IconUrl DefaultValue="https://localhost:7296/outlook/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:7296/outlook/icon-80.png" />
  <SupportUrl DefaultValue="https://localhost:7296/access-requests" />

  <AppDomains>
    <AppDomain>https://localhost:7296</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:7296/outlook/commands.html" />
        <RequestedHeight>100</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>

  <!-- Activation: every mail. The button is always on the ribbon (no word filter). -->
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url" />

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mantiGroup">
                  <Label resid="Group.Label" />
                  <Control xsi:type="Button" id="mantiOpenButton">
                    <Label resid="Button.Label" />
                    <Supertip>
                      <Title resid="Button.Label" />
                      <Description resid="Button.Tip" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16" />
                      <bt:Image size="32" resid="Icon.32" />
                      <bt:Image size="80" resid="Icon.80" />
                    </Icon>
                    <!-- A side panel (no "wants to display a new window" question, which a popup always asks) -->
                    <Action xsi:type="ShowTaskpane">
                      <TaskpaneId>mantiPane</TaskpaneId>
                      <SourceLocation resid="Taskpane.Url" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://localhost:7296/outlook/icon-16.png" />
          <bt:Image id="Icon.32" DefaultValue="https://localhost:7296/outlook/icon-32.png" />
          <bt:Image id="Icon.80" DefaultValue="https://localhost:7296/outlook/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://localhost:7296/outlook/commands.html" />
          <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:7296/outlook/taskpane.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="MANTI3" />
          <bt:String id="Button.Label" DefaultValue="הרשאות" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tip" DefaultValue="פותח את בקשת ההרשאות של MANTI3 בחלון קופץ" />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
